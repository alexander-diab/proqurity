{
  // ── Interpreter ───────────────────────────────────────────────────────────
  // Absolut auf das Projekt-venv gepinnt. Auf dieser Maschine haengt ein fremdes
  // venv (udacity_agentic) im PATH; ohne diesen Pin gewinnt es gelegentlich.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,

  // ── Suche und Explorer ────────────────────────────────────────────────────
  // data/ ist 2,2 GB. Ohne Ausschluss wird jede Volltextsuche unbenutzbar.
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "data/**": true,
    ".venv/**": true,
    "vendor/**": true,
    "build/**/*.csv": true,
    "build/**/*.gz": true,
    "build/*.zip": true,
    "build/graph_voll/03_events.cypher": true,
    "build/graph_schlank/03_events.cypher": true
  },
  "files.watcherExclude": {
    "data/**": true,
    ".venv/**": true,
    "vendor/**": true
  },

  // ── Python ────────────────────────────────────────────────────────────────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}/build/graph_schlank",
    "${workspaceFolder}/build/agent"
  ],

  // ── Cypher / Markdown ─────────────────────────────────────────────────────
  "files.associations": {
    "*.cypher": "cypher",
    "*.mermaid": "markdown"
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": [100]
  }
}
