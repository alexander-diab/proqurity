# Vorlage. Kopieren nach .env und ausfüllen — .env ist per .gitignore ausgeschlossen.
#
#   cp .env.example .env
#
# Die Neo4j-Werte stehen in neo4j_key/Neo4j-<id>-Created-<datum>.txt,
# der Aura-Konsole (console.neo4j.io) oder werden bei Instanzanlage einmalig angezeigt.

# ── Neo4j Aura ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# befund_mcp.py liest historisch NEO4J_USER statt NEO4J_USERNAME.
# Beide setzen, dann funktionieren alle Skripte ohne Anpassung.
NEO4J_USER=neo4j

# ── Modellzugang (wird am Hackathon gestellt) ───────────────────────────────
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
BEFUND_MODELL=openai:gpt-4o

# ── Optional: Tracing ───────────────────────────────────────────────────────
# Ohne Token schreibt Logfire nur auf die Konsole.
LOGFIRE_TOKEN=

# ── Pfade ───────────────────────────────────────────────────────────────────
# Relativ zum Skriptordner build/agent/ — nur ändern, wenn Skripte verschoben werden.
KORPUS_PFAD=../korpus
GROUND_TRUTH=../korpus/master/ground_truth.jsonl
BEFUND_MCP=http://127.0.0.1:8000/mcp
